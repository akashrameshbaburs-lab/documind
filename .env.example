# ---------------------------------------------------------------------------
# DocuMind AI - environment configuration
# Copy to .env (or export in your shell / docker compose environment).
# Every variable the app reads is listed here.
# ---------------------------------------------------------------------------

# --- Core server -------------------------------------------------------------
# HTTP port the Express server listens on (compose maps host 3200 -> 3200).
PORT=3200

# Log verbosity for pino (trace|debug|info|warn|error|fatal).
LOG_LEVEL=info

# --- Database ----------------------------------------------------------------
# Postgres 16 + pgvector connection string.
# Inside docker compose the app uses the `postgres` service host:
#   postgres://documind:documind@postgres:5432/documind
# From the host machine (npm run dev / npm run evaluate) use the mapped port 5434:
#   postgres://documind:documind@localhost:5434/documind
DATABASE_URL=postgres://documind:documind@localhost:5434/documind

# --- Security ----------------------------------------------------------------
# Secret used to sign JWT access tokens. MUST be set to a long random value in
# production. The default is a well-known insecure dev value.
JWT_SECRET=change-me-to-a-long-random-string

# Users whose email equals this value get admin rights (e.g. GET /api/admin/feedback).
ADMIN_EMAIL=admin@documind.local

# --- Usage limits ------------------------------------------------------------
# Maximum chat queries allowed per user per UTC day. Exceeding it returns 429.
MAX_QUERIES_PER_DAY=100

# --- Uploads -----------------------------------------------------------------
# Max size per uploaded file, in megabytes (pdf/docx/txt/md).
UPLOAD_MAX_MB=15

# --- LLM provider (OPTIONAL - app is fully functional without it) ------------
# When OPENAI_API_KEY is empty/unset the app runs in OFFLINE EXTRACTIVE MODE:
#   - feature-hashing embeddings (1536 dims, deterministic, no network)
#   - hybrid retrieval (cosine + Postgres full-text, reciprocal-rank fusion)
#   - extractive answers assembled from top passages with citations.
# When OPENAI_API_KEY is set the app runs in LLM MODE:
#   - text-embedding-3-small embeddings
#   - chat completions generate the answer (still grounded in retrieved chunks).
OPENAI_API_KEY=

# OpenAI models used only when OPENAI_API_KEY is set.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o-mini
